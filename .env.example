# ─── Required ──────────────────────────────────────────────────────────────────
# Swoop refuses to start in production unless both of these are set to real
# values. It will not fall back to a default secret.

# Encrypts SuperOps and AI credentials before they are written to SQLite.
#   openssl rand -hex 32
# Changing this later makes existing stored credentials unreadable — you would
# have to re-enter them in Settings. Back it up with your database.
ENCRYPTION_KEY=

# Signs session tokens. At least 32 characters.
#   openssl rand -hex 32
JWT_SECRET=

# ─── Database ──────────────────────────────────────────────────────────────────
# A single SQLite file. Back it up by copying the file while the container is
# stopped, or use `sqlite3 swoop.db ".backup out.db"` while it is running.
SQLITE_PATH=./data/swoop.db

# ─── AI provider ───────────────────────────────────────────────────────────────
# Optional here — the setup wizard can configure this instead, and anything set
# in the UI takes precedence over these values.
#
# Any OpenAI-compatible endpoint works. `/v1` is appended automatically if you
# leave it off.

# Ollama, running on the same host:
AI_BASE_URL=http://localhost:11434
AI_API_KEY=
AI_MODEL=qwen3:8b

# Ollama, from inside a Docker container:
# AI_BASE_URL=http://host.docker.internal:11434

# OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# How long to wait for a completion. Large local models on CPU are slow, so the
# default is generous.
# AI_TIMEOUT_MS=300000

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Default poll interval for tenants that have not set their own in Settings.
# Clamped to 15–3600 seconds.
# POLL_INTERVAL_SECONDS=60

# ─── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error
# LOG_LEVEL=info
# Set to json to emit one JSON object per line for a log collector.
# LOG_FORMAT=

# ─── Networking ────────────────────────────────────────────────────────────────
# Honour X-Forwarded-For. Enable ONLY when Swoop is behind a reverse proxy you
# control — otherwise a client can spoof the header and defeat rate limiting.
# TRUST_PROXY=0

# Allow a browser origin other than Swoop's own to call the API. Needed only
# when running the Vite dev server against a separate backend.
# CORS_ORIGIN=http://localhost:5173

# Overrides the SuperOps API endpoint. Leave unset to pick it from the tenant's
# configured data centre. Useful for an egress proxy, or a local mock.
# SUPEROPS_API_URL=
