# ─── Required ─────────────────────────────────────────────────────────────────
# 32-character random string — generate with: openssl rand -hex 16
ENCRYPTION_KEY=change_me_32_chars_random_string_

# JWT secret for session tokens — generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string_here

# ─── Database ─────────────────────────────────────────────────────────────────
SQLITE_PATH=./data/swoop.db

# ─── AI Provider ──────────────────────────────────────────────────────────────
# Ollama (local)
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_MODEL=qwen3:8b

# OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# Groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama3-70b-8192

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
