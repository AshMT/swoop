{
  "name": "swoop",
  "version": "1.0.0",
  "description": "Open source AI ticket triage for MSPs — classifies PSA tickets and proposes actions, read-only by default",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:web": "cd web && npm run dev",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json",
    "build:web": "cd web && npm run build",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && cd web && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.30.10",
    "express": "^4.19.2",
    "graphql-request": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.2",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "drizzle-kit": "^0.21.4",
    "eslint": "^9.39.5",
    "supertest": "^7.2.2",
    "tsx": "^4.15.6",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.9"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  }
}
